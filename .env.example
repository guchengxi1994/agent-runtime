# OpenAI-compatible model provider
OPENAI_API_KEY=replace-me
AGENT_RUNTIME_MODEL=gpt-4.1-mini

# Optional for OpenAI-compatible gateways, DeepSeek/Qwen-compatible endpoints, or private model routers.
# You can also use OPENAI_BASE_URL; AGENT_RUNTIME_OPENAI_BASE_URL takes precedence.
AGENT_RUNTIME_OPENAI_BASE_URL=
OPENAI_BASE_URL=

# Optional reasoning controls.
# Only set AGENT_RUNTIME_REASONING_EFFORT when your provider/model supports it.
AGENT_RUNTIME_REASONING_EFFORT=
AGENT_RUNTIME_EXPOSE_REASONING_CONTENT=false

# Agent runtime
AGENT_RUNTIME_HOST=0.0.0.0
AGENT_RUNTIME_PORT=8010
AGENT_RUNTIME_REGISTRY_DIR=./registry
AGENT_RUNTIME_SANDBOX_URL=http://127.0.0.1:8001
AGENT_RUNTIME_MAX_RUNTIME_ROUNDS=6
AGENT_RUNTIME_REQUEST_TIMEOUT_SECONDS=600
AGENT_RUNTIME_LOG_LEVEL=INFO

# Sandbox
ARTISAN_PLUGIN_SERVER_PORT=8001
ARTISAN_PLUGIN_RUNTIME_DIR=./plugins_runtime
ARTISAN_PLUGIN_TIMEOUT=300000
ARTISAN_PLUGIN_IDLE_TIMEOUT=120000
ARTISAN_PLUGIN_MAX_CONCURRENCY=8
ARTISAN_PLUGIN_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Example secret consumed by executable skills through required_secrets.
UPSTREAM_API_TOKEN=
