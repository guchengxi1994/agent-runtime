# OpenAI-compatible model provider
OPENAI_API_KEY=replace-me
AGENT_RUNTIME_MODEL=gpt-4.1-mini

# Optional for OpenAI-compatible gateways, DeepSeek/Qwen-compatible endpoints, or private model routers.
OPENAI_BASE_URL=

# Optional reasoning controls.
# Only set AGENT_RUNTIME_REASONING_EFFORT when your provider/model supports it.
AGENT_RUNTIME_REASONING_EFFORT=
AGENT_RUNTIME_EXPOSE_REASONING_CONTENT=false

# Agent runtime
AGENT_RUNTIME_HOST=0.0.0.0
AGENT_RUNTIME_PORT=8010
AGENT_RUNTIME_REGISTRY_DIR=./registry
AGENT_RUNTIME_ARTIFACTS_DIR=./artifacts
AGENT_RUNTIME_SANDBOX_URL=http://127.0.0.1:8001
AGENT_RUNTIME_MAX_RUNTIME_ROUNDS=20
AGENT_RUNTIME_REQUEST_TIMEOUT_SECONDS=600
AGENT_RUNTIME_LOG_LEVEL=INFO
AGENT_RUNTIME_HTTP_LOG_LEVEL=WARNING

# Sandbox
ARTISAN_PLUGIN_SERVER_PORT=8001
ARTISAN_PLUGIN_RUNTIME_DIR=./plugins_runtime
ARTISAN_PLUGIN_TIMEOUT=300000
ARTISAN_PLUGIN_IDLE_TIMEOUT=120000
ARTISAN_PLUGIN_MAX_CONCURRENCY=8
ARTISAN_PLUGIN_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# Example secret consumed by executable skills through required_secrets.
UPSTREAM_API_TOKEN=

# PostgreSQL for local development. When using docker compose, sandbox can reach it via host `postgres`.
POSTGRES_DB=agent_runtime
POSTGRES_USER=agent_runtime
POSTGRES_PASSWORD=agent_runtime
PGHOST=postgres
PGPORT=5432
PGDATABASE=agent_runtime
PGUSER=agent_runtime
PGPASSWORD=agent_runtime

# Optional override for pg-risk-dataset-sync. By default it reads the bundled dataset in the skill package.
PG_RISK_DATA_DIR=

# Increase bundle upload limit when executable skills carry larger assets such as Excel datasets.
ARTISAN_PLUGIN_MAX_BODY_BYTES=4194304

# Optional search providers used by the web-search executable skill.
# Configure one of these for academic-deep-research.
TAVILY_API_KEY=
SERPER_API_KEY=
BING_SEARCH_API_KEY=
