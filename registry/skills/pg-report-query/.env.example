# Preferred: a single DSN is the cleanest way to configure PostgreSQL access.
PG_DSN=postgresql://agent_runtime:agent_runtime@postgres:5432/agent_runtime

# Fallback: if PG_DSN is not set, the skill will read the split PostgreSQL variables below.
PGHOST=postgres
PGPORT=5432
PGDATABASE=agent_runtime
PGUSER=agent_runtime
PGPASSWORD=agent_runtime
